<div class="favorites-page">
  <h1>お気に入り</h1>

  <section class="favorites-section">
    <h2>キャンプ場・温泉施設</h2>

    <% @favorites.each do |favorite| %>
      <div
        class="detail-box"
        data-favorite-item
        data-campsite-place-id="<%= favorite.campsite_place_id %>"
        data-onsen-place-id="<%= favorite.onsen_place_id %>"
      >
        <%= link_to search_path(
          campsite_place_id: favorite.campsite_place_id,
          onsen_place_id: favorite.onsen_place_id
        ) do %>
          <div>
            <h3>キャンプ場</h3>
            <p data-campsite-name>施設名を取得中...</p>
          </div>

          <div>
            <h3>温泉施設</h3>
            <p data-onsen-name>施設名を取得中...</p>
          </div>
        <% end %>

        <button
          type="button"
          data-favorite-delete
        >
          お気に入りから削除
        </button>
      </div>
    <% end %>
  </section>
</div>
