<div style="display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 100vh;">
  
  <!-- タイトル -->
  <h1>プロフィール</h1>

  <!-- 名前のラベル -->
  <div style="width: 400px; text-align: left; margin-top: 20px;">
    名前
  </div>
  
  <!-- 名前の枠 -->
  <div style="border: 1px solid #ccc; padding: 15px; width: 400px; text-align: left;">
    <%= current_user.name %>
  </div>

  <!-- メールアドレスのラベル -->
  <div style="width: 400px; text-align: left; margin-top: 20px;">
    メールアドレス
  </div>
  
  <!-- メールアドレスの枠 -->
  <div style="border: 1px solid #ccc; padding: 15px; width: 400px; text-align: left;">
    <%= current_user.email %>
  </div>

  <!-- ボタン -->
  <%= link_to "情報を更新する", edit_user_registration_path, style: "margin-top: 20px;" %>
  
</div>