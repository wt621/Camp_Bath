<div class="profile-container">

  <!-- タイトル -->
  <h1>プロフィール</h1>

  <!-- 名前のラベル -->
  <div class="profile-field">
    名前
  </div>

  <!-- 名前の枠 -->
  <div class="profile-value">
    <%= current_user.name %>
  </div>

  <!-- メールアドレスのラベル -->
  <div class="profile-field">
    メールアドレス
  </div>

  <!-- メールアドレスの枠 -->
  <div class="profile-value">
    <%= current_user.email %>
  </div>

  <!-- ボタン -->
  <%= link_to "情報を更新する", edit_user_registration_path, class: "profile-button" %>

</div>