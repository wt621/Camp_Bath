<div class="container">
  <% region_name = AreaData::REGIONS[@region.to_sym][:name] rescue @region %>
  <h1><%= region_name %> - 都道府県を選択してください</h1>

  <ul>
    <% @prefectures.each do |prefecture_key, prefecture_data| %>
      <li>
        <%= link_to prefecture_data[:name], search_areas_path(region: @region, prefecture: prefecture_key) %>
      </li>
    <% end %>
  </ul>

  <%= link_to '地方選択に戻る', search_regions_path %>
</div>
