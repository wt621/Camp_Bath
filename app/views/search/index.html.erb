<div class="search-container">

  <%= render "campsite_panel" %>

  <div id="map-container">

    <div id="map"></div>

    <button
      id="current-location-button"
      type="button"
    >
      <%= image_tag "gps_icon.png", alt: "現在地" %>
    </button>

  </div>

  <%= render "onsen_panel" %>

  <%= render "campsite_image_panel" %>

  <%= render "weather_panel" %>

</div>


<script>

  // Railsから緯度・経度を受け取る
  window.searchCenter = {
    lat: <%= @latitude %>,
    lng: <%= @longitude %>
  };

</script>
