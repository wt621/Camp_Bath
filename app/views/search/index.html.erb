<% content_for :head do %>
  <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&libraries=places,geometry&v=weekly" defer></script>
  <% end %>

<div class="search-container"> 
  <div id="campsite-panel" class="side-panel hidden">
    <button id="close-campsite-panel" class="close-button hidden">×</button>
    <div id="campsite-content">
      <h2>キャンプ場情報</h2>
      <p>キャンプ場を選択してください</p>
    </div>
  </div>

  <div id="map"></div>

  <div id="onsen-panel" class="side-panel hidden">
    <button id="close-onsen-panel" class="close-button hidden">×</button>
    <div id="onsen-content">
      <h2>温泉施設情報</h2>
      <p>温泉を選択してください</p>
    </div>
  </div>
</div>