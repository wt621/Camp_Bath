<div class="hero-container">

  <% if user_signed_in? %>
    <div class="bottom-actions">
      <%= link_to "検索する", search_regions_path, class: "btn-search-top" %>

      <%= link_to "使用方法", how_to_use_path, class: "btn-search-top" %>

      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn-search-top" %>
    </div>
  <% else %>
    <div class="bottom-actions bottom-actions-guest">
      <%= link_to "新規登録", new_user_registration_path, class: "btn-search-top" %>

      <%= link_to "検索する", search_regions_path, class: "btn-search-top" %>

      <%= link_to "使用方法", how_to_use_path, class: "btn-search-top" %>

      <%= link_to "ログイン", new_user_session_path, class: "btn-search-top" %>
    </div>
  <% end %>

</div>
