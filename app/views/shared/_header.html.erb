<header class="app-header">
  <%= link_to root_path do %>
    <%= image_tag "header_logo.png",
          alt: "Camp-Bath",
          class: "header-logo" %>
  <% end %>

  <% if user_signed_in? %>
    <nav
      class="header-nav"
      data-controller="hamburger"
    >
      <button
        id="hamburger-button"
        class="hamburger-button"
        data-action="click->hamburger#toggle"
      >
        ≡
      </button>

      <ul
        id="hamburger-menu"
        class="hamburger-menu"
        data-hamburger-target="menu"
      >
        <li class="hamburger-item">
          <%= link_to "ユーザー設定", profile_path %>
        </li>
        <li class="hamburger-item">
          <%= link_to "お気に入り", favorites_path %>
        </li>
        <li class="hamburger-item">
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %>
        </li>
      </ul>
    </nav>
  <% end %>
</header>
